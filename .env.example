# ===========================================
# A2R RAG API - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git

# MongoDB Atlas Configuration
# Get this from your MongoDB Atlas dashboard after creating a new user
MONGO_URI=mongodb+srv://a2rsoftware:ELLWHXhm8YINDi27@cluster0.2un4ng3.mongodb.net/
MONGO_DB=rag_db
MONGO_COLLECTION=documents
VECTOR_INDEX=rag-chatbot-index

# Embeddings Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Ollama Configuration (Remote Service)
# For production: http://ollama-runner.internal:11434
# For local testing: http://localhost:11434
OLLAMA_BASE_URL=http://ollama-runner.internal:11434
OLLAMA_MODEL=mistral

# LangSmith Configuration (Optional - for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=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
LANGCHAIN_PROJECT=A2R-RAG

# Application Configuration
LOG_LEVEL=INFO
API_TITLE=A2R RAG API
API_VERSION=1.0.0
PORT=8080

# Development/Testing Only
# Set to "production" to disable docs endpoints
ENVIRONMENT=development

# Data Pipeline (for local development)
DATA_DIR=./data
CHUNKS_PATH=./data/processed/chunks.json