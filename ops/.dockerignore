# ===========================================
# A2R RAG API - Docker Build Exclusions
# ===========================================
# Exclude unnecessary files from Docker build context

# Environment & Secrets
.env
.env.*
env.txt
*.env

# Data & Documents
data/
*.pdf
*.docx
*.doc
chunks.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
ENV/
env/
.venv/

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS Generated
.DS_Store
.DS_Store?
._*
Thumbs.db

# Git
.git/
.gitignore

# Logs
*.log
logs/

# Testing
.pytest_cache/
htmlcov/
.coverage
.hypothesis/

# Documentation
*.md
docs/

# Scripts (not needed in container)
scripts/

# Old FAISS files
db/
*.faiss
*.pkl

# Frontend (not needed for API)
frontend/
static/

# Development tools
.editorconfig
.pre-commit-config.yaml

# Cloud files
.gcloudignore